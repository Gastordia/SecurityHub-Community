  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "@tanstack/react-query": "^5.87.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "axios": "^1.18.1",
    "clsx": "^2.0.0",
    "react": "^19.2.7",
    "react-dom": "^18.2.0",
