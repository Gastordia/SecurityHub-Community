    "production": [
      "iOS >= 9",
      "Android >= 4.4",
      "last 2 versions",
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@vitest/ui": "^4.1.9",
    "autoprefixer": "^10.4.17",
    "jsdom": "^24.0.0",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
